# FoodConnect Environment Configuration
# Copy this file to .env or export variables in your shell / IDE

# Server Port
PORT=8080

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=foodconnect_db
