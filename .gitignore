# ============================================================
# FoodConnect Root .gitignore
# ============================================================

# Compiled Java / Maven artifacts
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Node / Frontend artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
*.local

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!*.env.example

# Logs
logs/
*.log
npm-debug.log*

# IDE & Editor files
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary files & Scratch dirs
scratch/
tmp/
temp/
